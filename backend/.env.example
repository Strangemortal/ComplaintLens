# QMS AI Complaint Co-Pilot Configuration

# Choose either Groq or Google Gemini API Key:
# Option 1: Groq API Key (Recommended by default, model: llama-3.3-70b-versatile)
GROQ_API_KEY=

# Option 2: Google Gemini API Key (Fallback, model: gemini-1.5-flash)
GEMINI_API_KEY=

# SQLite Database path
DATABASE_URL=sqlite:///./qms_complaints.db

# Server Port
PORT=8000
